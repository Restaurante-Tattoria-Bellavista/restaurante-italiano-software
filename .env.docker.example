# Copiar a .env en la raiz del proyecto (NO versionar)
# Solo usar caracteres alfanumericos en POSTGRES_PASSWORD con esta plantilla de URI.
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
FRONTEND_PORT=8080

# Autenticacion (ingreso facial y contrasena). Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=CAMBIAR_AUTH_SECRET
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=443

# Token de los gateways BLE (ESP32). Generar con secrets.token_urlsafe(32)
GATEWAY_TOKEN=CAMBIAR_GATEWAY_TOKEN
# Grafana (http://localhost:3000, usuario admin)
GRAFANA_ADMIN_PASSWORD=CAMBIAR_PASSWORD
GRAFANA_DB_PASSWORD=CAMBIAR_PASSWORD
GRAFANA_PORT=3000

# Terminal de voz ESP32 -> backend expuesto en BACKEND_PORT
BACKEND_PORT=8001
VOZ_DEVICE_KEY=
GEMINI_API_KEY=
