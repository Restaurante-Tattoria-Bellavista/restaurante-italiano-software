# Copiar a .env en la raiz del proyecto (NO versionar)
# Solo usar caracteres alfanumericos en POSTGRES_PASSWORD con esta plantilla de URI.
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
FRONTEND_PORT=8080

# Autenticacion (ingreso facial y contrasena). Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=CAMBIAR_AUTH_SECRET
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=443

# Token de los gateways BLE (ESP32). Generar con secrets.token_urlsafe(32)
GATEWAY_TOKEN=CAMBIAR_GATEWAY_TOKEN

# Pedidos por voz. GEMINI_API_KEY se obtiene en https://aistudio.google.com/apikey (capa gratuita).
# Sin ella el asistente usa solo el interprete local por reglas (y el audio del ESP32 no funciona).
GEMINI_API_KEY=
# Clave de la terminal ESP32 (header X-Device-Key). Obligatoria para POST /api/v1/voz/audio.
# Generar con secrets.token_urlsafe(32) y poner el mismo valor en firmware/voice-terminal/include/config.h
VOZ_DEVICE_KEY=CAMBIAR_VOZ_DEVICE_KEY

# Ingreso facial (opcionales; los valores por defecto son los de docs/ia.md).
# FACE_UMBRAL=0.55
# FACE_UMBRAL_1A1=0.60
