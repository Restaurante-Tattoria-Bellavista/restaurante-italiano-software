# Copiar como backend/.env (no subir contrasenas reales al repositorio)
APP_NAME=Trattoria Bellavista API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://restaurant:CAMBIAR_CLAVE@localhost:5432/restaurant
DATABASE_CONNECT_TIMEOUT=3

# Clave para firmar sesiones. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=CAMBIAR_AUTH_SECRET

# Pedidos por voz (ver README, seccion Pedido por voz). Sin GEMINI_API_KEY solo funciona el interprete por reglas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Obligatoria para que la terminal ESP32 pueda enviar audio (header X-Device-Key).
VOZ_DEVICE_KEY=
